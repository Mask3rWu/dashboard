; Server-only template. Copy to flight_analyzer.ini beside FlightAnalyzerServer.exe.
; Keep this file on the server and restrict read access because it contains the MySQL password.

[server]
host = 0.0.0.0
port = 9000
data_dir = D:\FlightAnalyzerServer\data

[mysql]
host = 127.0.0.1
port = 3306
database = flight_analyzer
user = flight
password = CHANGE_ME
charset = utf8mb4

; Optional full SQLAlchemy URL. If set, it overrides the fields above.
; url = mysql+pymysql://flight:CHANGE_ME@127.0.0.1:3306/flight_analyzer?charset=utf8mb4

[dev]
; Apply packaged aircraft-model seeds to a fresh server database.
load_server = true
