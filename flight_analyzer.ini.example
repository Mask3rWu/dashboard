; Copy this file to flight_analyzer.ini and fill in real values.
; Environment variables still override values in this file.

[local]
; Local desktop/offline data cache. Leave blank to use the default app data dir.
data_dir =

; The collaboration server API address reachable from this computer.
; Keep the /api suffix because server endpoints are mounted under /api.
server_base_url = http://SERVER_IP_OR_HOSTNAME:9000/api

[server_auth]
; Used by script/generate_builtin_model_seeds.py before packaging.
; This is the Flight Analyzer server login, not the MySQL account.
username = admin
password = CHANGE_ME
; token =

[server]
; Use 0.0.0.0 on the server so other machines in the research network can connect.
host = 0.0.0.0
port = 9000

; Stores uploaded raw-file objects and generated sync bundles.
data_dir = D:\FlightAnalyzerServer\data

[mysql]
host = 127.0.0.1
port = 3306
database = flight_analyzer
user = flight
password = CHANGE_ME
charset = utf8mb4

; Optional full SQLAlchemy URL. If set, it overrides the host/user/password fields above.
; url = mysql+pymysql://flight:CHANGE_ME@127.0.0.1:3306/flight_analyzer?charset=utf8mb4

[dev]
; Controls whether packaged local installs preload backend/builtin_model_seeds.json.
; The same file contains built-in model definitions and the preseeded server-account cache.
load_local = true

; Controls whether server startup applies built-in model seeds to MySQL.
load_server = true
